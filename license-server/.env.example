# Database
DATABASE_URL=postgresql://user:password@localhost:5432/krispoint_licenses

# Server
PORT=3001
NODE_ENV=development
SERVER_URL=https://license.yourdomain.com.gh

# Paystack (Ghana)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Dashboard
ADMIN_EMAIL=admin@yourdomain.com.gh
ADMIN_PASSWORD=change-this-strong-password

# SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=KrisPoint Licensing <noreply@yourdomain.com.gh>

# JWT for Admin Sessions
JWT_SECRET=your-jwt-secret-for-admin-auth-min-32-chars
JWT_EXPIRES_IN=24h

# Note: Ed25519 signing keys are auto-generated on first start
# They are stored in the keys/ folder - back these up!
