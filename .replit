modules = ["python-3.11", "nodejs-20", "rust", "python3", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_object_storage:1.0.0", "javascript_database:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["portaudio", "webkitgtk_4_1", "imagemagick", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SvelteKit Dev Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "License Server"


[[workflows.workflow]]
name = "SvelteKit Dev Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "VITE_KRISPOINT_EDITION=hospital VOICE_CLIENT_TOKEN=\"${SESSION_SECRET}-hospital-voice\" npm run dev -- --host 0.0.0.0 --port 5000 --strictPort"
waitForPort = 5000

[[workflows.workflow]]
name = "License Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd license-server && node src/index.js"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "license-server/src/index.js"]
build = ["bash", "-c", "cd license-server && npm install"]

[userenv]

[userenv.shared]
PAYSTACK_TEST_PUBLIC_KEY = "pk_test_9226a181ec19516e13d14073c67aeba39abbcd6e"
LICENSE_SERVER_PORT = "3001"
SMTP_HOST = "smtp-relay.brevo.com"
SMTP_PORT = "587"
SMTP_SECURE = "false"
EMAIL_FROM = "KrisPoint Licensing <info@krispoint.com.gh>"

[userenv.development]
LICENSE_SERVER_URL = "https://4779a892-71b2-4d30-9818-4270a8f176f1-00-2qjklbtzcv091.janeway.replit.dev/license-server"

[userenv.production]
LICENSE_SERVER_URL = "https://license.krispoint.com.gh"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000
