modules = ["nodejs-24", "python-3.11", "rust-stable"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "KrisPoint License Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "KrisPoint MedASR"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "KrisPoint AI Gateway"

[[workflows.workflow]]
name = "KrisPoint License Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "LICENSE_SERVER_PORT=3001 pnpm --filter @workspace/license-server run start"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "KrisPoint MedASR"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd vosk-server/src && ASR_ENGINE=medasr VOICE_HOST=127.0.0.1 VOICE_PORT=8000 VOICE_CLIENT_TOKEN=\"$SESSION_SECRET-hospital-voice\" uv run python websocket_server.py"

[[workflows.workflow]]
name = "KrisPoint AI Gateway"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "KRISPOINT_LICENSE_PUBLIC_KEY=\"$(cat license-server/keys/public.key)\" KRISPOINT_LICENSE_SERVER_URL=http://127.0.0.1:3001 HOST=0.0.0.0 PORT=8099 pnpm --filter @workspace/ai-gateway run start"
waitForPort = 8099

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["pkg-config", "glib", "gtk3", "webkitgtk_4_1", "portaudio", "zlib"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000
exposeLocalhost = true
