{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KrisPoint",
  "version": "1.0.0",
  "identifier": "com.krispoint.radiology",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5000",
    "beforeDevCommand": "npm run dev:solo",
    "beforeBuildCommand": "npm run build:solo"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KrisPoint - Radiology Reporting System",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../build",
      "../voice-runtime/**/*",
      "../solo-runtime/**/*"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  }
}
