ASR_ENGINE=medasr
# MedASR configuration
MEDASR_MODEL_ID=google/medasr
MEDASR_DEVICE=cpu
# Required only for the first gated-model download:
# HF_TOKEN=hf_replace_with_your_read_only_token
MEDASR_CPU_THREADS=4
# Queue duration is bounded to 0.5-60 seconds; oldest audio is dropped on overload.
MEDASR_VAD_QUEUE_SECONDS=5
MEDASR_VAD_SILENCE_SECONDS=1.5
MEDASR_VAD_MAX_UTTERANCE_SECONDS=30
MEDASR_VAD_PRE_ROLL_SECONDS=0.25
MEDASR_VAD_MIN_SPEECH_SECONDS=0.15
MEDASR_VAD_MIN_RMS=0.005
MEDASR_VAD_SPEECH_MARGIN_DB=10
MEDASR_VAD_NOISE_CALIBRATION_SECONDS=0.5
MEDASR_VAD_STARTUP_SPEECH_RMS=0.04
MEDASR_VAD_RELEASE_MARGIN=1.5

# faster-whisper Model Configuration (retained for Whisper support)
# OPTIONAL: Set the path to your local Whisper model directory
# If not set, model will auto-download (default: "medium")
# Supported models: tiny, base, small, medium, large-v3

# For local model (if you have it downloaded):
# Windows example:
# WHISPER_MODEL_PATH=C:\Users\YourName\Desktop\whisper-models\medium

# Mac/Linux example:
# WHISPER_MODEL_PATH=/home/yourusername/whisper-models/medium

# For auto-download, use model size name (recommended for first-time setup):
# WHISPER_MODEL_PATH=medium  # Good balance of speed and accuracy
# WHISPER_MODEL_PATH=large-v3  # Best accuracy, slower

# If not set, defaults to "medium" and will auto-download on first run

# WebSocket server configuration
# Use 127.0.0.1 for same-computer KrisPoint; use 0.0.0.0 only for trusted LAN clients.
VOICE_HOST=127.0.0.1
VOICE_PORT=8000

# Audio Configuration
SAMPLE_RATE=16000
CHUNK_SIZE=8000
