{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "dev": "pnpm run dev:hospital",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:hospital": "pnpm --filter @workspace/krispoint run db:migrate:hospital && VITE_KRISPOINT_EDITION=hospital VOICE_CLIENT_TOKEN=\"${SESSION_SECRET}-hospital-voice\" pnpm --filter @workspace/krispoint run dev",
    "build:hospital": "pnpm --filter @workspace/krispoint run build",
    "dev:solo": "node scripts/run-solo.mjs dev --host 0.0.0.0 --port 5000",
    "build:solo": "node scripts/run-solo.mjs build && node scripts/package-solo-backend.mjs && node scripts/package-solo-voice.mjs",
    "build:solo:installer": "tauri build",
    "test:solo:installer": "node --test scripts/tests/solo-installer.test.mjs",
    "test:ai": "node --test scripts/tests/ai-polish.test.mjs && pnpm --dir artifacts/api-server test",
    "test:migration": "node --test scripts/tests/migration.test.mjs",
    "test:voice": "node --test scripts/tests/voice-ticket.test.mjs && python3 -m unittest discover -s vosk-server/tests -p 'test_*.py'",
    "test:deployment": "node --test scripts/tests/hospital-deploy-contract.test.mjs && node --experimental-strip-types --test artifacts/krispoint/src/lib/server/validateEnvironment.test.ts",
    "deploy:hospital:install": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/hospital-deploy/install.ps1",
    "deploy:hospital:update": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/hospital-deploy/update.ps1",
    "deploy:hospital:rollback": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/hospital-deploy/rollback.ps1",
    "deploy:hospital:status": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/hospital-deploy/status.ps1",
    "db:push": "pnpm --filter @workspace/krispoint run db:push",
    "db:generate": "pnpm --filter @workspace/krispoint run db:generate",
    "db:migrate:hospital": "node scripts/migrate-active-template-identity.mjs",
    "tauri": "tauri"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "0.28.2",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
