# Machine-local Hospital deployment template. Copy this file to a protected
# path such as C:\ProgramData\KrisPoint\hospital.env; do not commit that copy.
DATABASE_URL=postgresql://krispoint_app:change-me@localhost:5432/krispoint
ENCRYPTION_KEY=
VOICE_CLIENT_TOKEN=
VITE_VOSK_SERVER_URL=ws://127.0.0.1:8000
VITE_KRISPOINT_EDITION=hospital
LICENSE_SERVER_URL=https://license.krispoint.com.gh
HOST=0.0.0.0
PORT=5000
NODE_ENV=production
# Required organisation-issued TLS files outside Git. The supported Hospital
# deployment refuses to install or start over plaintext.
SSL_CERT_PATH=
SSL_KEY_PATH=
REQUIRE_HTTPS=true
# Optional. Leave false when IIS or another reverse proxy owns port 80.
ENABLE_HTTP_REDIRECT=false