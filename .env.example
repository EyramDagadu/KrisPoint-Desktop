# ===========================================
# KrisPoint Medical - Environment Configuration
# ===========================================

# DATABASE (Required)
# PostgreSQL connection string
# For local development: postgresql://user:password@localhost:5432/krispoint
# For Neon cloud: postgresql://user:password@ep-xxx.region.neon.tech/krispoint
DATABASE_URL=postgresql://user:password@localhost:5432/krispoint

# Individual PostgreSQL variables (alternative to DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=krispoint

# ENCRYPTION (Required)
# 32-byte hex key for AES-256-GCM encryption of patient data
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_key_here

# VOICE RECOGNITION (Optional)
# WebSocket URL for Faster-Whisper voice server
# Leave empty for default behavior (localhost:8000)
# Example for local server: ws://localhost:8000
# Example for network server: ws://192.168.1.100:8000
VITE_VOSK_SERVER_URL=

# APPLICATION (Optional)
# Browser/server installations default to hospital mode. Tauri build commands
# set solo mode automatically. Uncomment only to override a development run.
# VITE_KRISPOINT_EDITION=hospital

# Set to 'production' for production deployment
NODE_ENV=development
